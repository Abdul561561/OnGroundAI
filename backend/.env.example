# ==============================================================================
# ONGROUND AI - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to backend/.env and replace placeholders with your credentials.
# NEVER commit the actual .env file with secrets into version control.

# MongoDB Atlas Connection
# Database: onground_ai
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=OnGroundAI
MONGODB_DATABASE=onground_ai

# OpenRouter Intelligence Layer
# Recommended Free Routing Model: openrouter/auto
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/auto

# Security & Session Authentication
# Generate a strong 32+ character random secret
JWT_SECRET=your_secure_random_jwt_secret_key_minimum_32_characters
JWT_EXPIRATION_HOURS=168
FRONTEND_ORIGIN=http://localhost:5173

# Telephony Configuration (Zero-Payment Mode: default "unconfigured")
# If unconfigured, the app runs in Zero-Payment Mode: internal WebRTC intercom is active,
# and PSTN carrier dialer honestly discloses that telephone trunking requires paid carriers.
TELEPHONY_PROVIDER=unconfigured
