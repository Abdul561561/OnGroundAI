# ==============================================================================
# ONGROUND AI - FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# In local development, Vite proxies /api and /ws automatically to http://127.0.0.1:8000.
# For production deployments (e.g. Vercel) connecting to a remote backend (e.g. Render):
# Copy this file to frontend/.env or set these in your Vercel Project Settings.

# Backend REST API endpoint (without trailing slash or with /api)
# In production, WebSocket signaling (/ws/signaling) is automatically derived from this URL (https -> wss).
# Example: https://ongroundai-ac3c.onrender.com
VITE_API_URL=http://localhost:8000
